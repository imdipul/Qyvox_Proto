2:["$","summary",null,{"children":[["$","span",null,{"children":"05"}],["$","strong",null,{"children":"What personal data is stored?"}]]}]
3:["$","p",null,{"children":"The verification table contains an authenticated user UUID, verification timestamp, and SHA-256 replay fingerprint. It has no date-of-birth, birth-year, age, address, name, or document-image column."}]
4:["$","details","What happens to the private input in the browser?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"06"}],["$","strong",null,{"children":"What happens to the private input in the browser?"}]]}],["$","p",null,{"children":"The birth year is passed to the local witness calculator, then both the React state and mutable local reference are cleared immediately after proof generation and again in the final error-cleanup path. JavaScript runtimes do not provide a formal secure-memory erasure guarantee, so Qyvox accurately describes this as prompt lifecycle minimization—not certified memory zeroization."}]]}]
5:["$","details","Is Groth16's trusted setup a central trust dependency?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"07"}],["$","strong",null,{"children":"Is Groth16's trusted setup a central trust dependency?"}]]}],["$","p",null,{"children":"It is a ceremony assumption, not an operator secret that should remain with Qyvox. Production requires an independently verifiable multi-party ceremony where security holds if at least one contributor destroys their secret randomness. The bundled one-machine ceremony is development-only."}]]}]
6:["$","details","Is Qyvox automatically GDPR, KYC, AML, or fintech compliant?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"08"}],["$","strong",null,{"children":"Is Qyvox automatically GDPR, KYC, AML, or fintech compliant?"}]]}],["$","p",null,{"children":"No product can truthfully guarantee universal compliance from architecture alone. Data minimization can materially reduce exposure, but lawful basis, notices, retention, user rights, sector rules, issuer trust, and deployment jurisdiction still require legal and operational review."}]]}]
7:["$","details","Can enterprises self-host the verifier?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"09"}],["$","strong",null,{"children":"Can enterprises self-host the verifier?"}]]}],["$","p",null,{"children":"The architecture is designed for it: the verification key and circuit artifacts are portable, and the verifier has no need for raw witness data. Production packaging, key provenance, monitoring, and service-level terms remain part of the commercialization roadmap."}]]}]
8:["$","details","What fails safely?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"10"}],["$","strong",null,{"children":"What fails safely?"}]]}],["$","p",null,{"children":"Malformed, oversized, off-curve, stale, ineligible, replayed, and unauthenticated requests are rejected. Verifier runtime failures return service errors rather than being misclassified as invalid proofs, and persistence failure never produces a successful receipt."}]]}]
9:["$","section",null,{"className":"trust-principles section-shell","children":[["$","div",null,{"children":[["$","p",null,{"className":"section-label","children":"02 / ENTERPRISE TRUST PRINCIPLES"}],["$","h2",null,{"children":"Adopt the proof, audit the assumptions."}]]}],["$","div",null,{"className":"principle-grid","children":[["$","article",null,{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Minimize custody"}],["$","p",null,{"children":"Do not collect a sensitive value when the business decision needs only a predicate."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Publish artifacts"}],["$","p",null,{"children":"Bind source, R1CS, proving key, verification key, ceremony transcript, and release checksums."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Fail closed"}],["$","p",null,{"children":"Reject malformed statements, stale epochs, verifier outages, and persistence failures by default."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"04"}],["$","h3",null,{"children":"Separate claims"}],["$","p",null,{"children":"Keep measured results, security assumptions, legal interpretation, and roadmap targets distinct."}]]}]]}]]}]
