0:{"buildId":"-jpEyOUnpcF2Ym2t8NW4u","data":[{"rsc":["$","$1","c",{"children":[["$","main",null,{"className":"inner-page faq-page","children":[["$","section",null,{"className":"page-hero","children":[["$","div",null,{"className":"page-hero-copy","children":[["$","p",null,{"className":"eyebrow","children":[["$","span",null,{"children":"TR"}]," ","Enterprise FAQ / trust architecture"]}],["$","h1",null,{"children":["Hard questions.",["$","br",null,{}],["$","span",null,{"children":"Bounded answers."}]]}],["$","p",null,{"children":"Security authority comes from stating assumptions, residual risk, and deployment obligations as clearly as the benefits."}]]}],["$","dl",null,{"className":"page-meta","children":[["$","div","No blockchain required",{"children":[["$","dt",null,{"children":"01"}],["$","dd",null,{"children":"No blockchain required"}]]}],["$","div","Proof-only API",{"children":[["$","dt",null,{"children":"02"}],["$","dd",null,{"children":"Proof-only API"}]]}],["$","div","Issuer layer planned",{"children":[["$","dt",null,{"children":"03"}],["$","dd",null,{"children":"Issuer layer planned"}]]}],["$","div","Compliance is contextual",{"children":[["$","dt",null,{"children":"04"}],["$","dd",null,{"children":"Compliance is contextual"}]]}]]}]]}],["$","section",null,{"className":"faq-layout section-shell","children":[["$","div",null,{"className":"faq-intro","children":[["$","p",null,{"className":"section-label","children":"01 / DUE DILIGENCE"}],["$","h2",null,{"children":"What technical reviewers should ask."}],["$","p",null,{"children":"Every answer below distinguishes the current research baseline from the controls required for a production identity network."}]]}],["$","div",null,{"className":"faq-list","children":[["$","details","Can Qyvox recover a user's birth year from a proof?",{"open":true,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"01"}],["$","strong",null,{"children":"Can Qyvox recover a user's birth year from a proof?"}]]}],["$","p",null,{"children":"The proof is designed to reveal only the public eligibility statement and current policy year. Recovering the private witness from a valid Groth16 proof should be computationally infeasible under the proving system's assumptions. Qyvox does not claim information-theoretic secrecy or that the public eligibility result reveals nothing—it reveals exactly that policy fact."}]]}],["$","details","Does Qyvox require a blockchain, gas fees, tokens, or cryptocurrency?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"02"}],["$","strong",null,{"children":"Does Qyvox require a blockchain, gas fees, tokens, or cryptocurrency?"}]]}],["$","p",null,{"children":"No. The baseline runs on standard web infrastructure: WebAssembly and SnarkJS in the browser, a FastAPI verification service, and PostgreSQL persistence. A blockchain is not required for proof generation or verification."}]]}],["$","details","How are replay attacks prevented today?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"03"}],["$","strong",null,{"children":"How are replay attacks prevented today?"}]]}],["$","p",null,{"children":"The current API hashes the canonical proof payload and enforces a unique proof fingerprint, blocking exact reuse. It also binds acceptance to the current UTC year and authenticated submitter. Cryptographic nonce, session, and expiry binding are planned for the next circuit revision; the current design should not be described as fully front-running resistant."}]]}],["$","details","Does Qyvox prove that the birth year is truthful?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"04"}],["$","strong",null,{"children":"Does Qyvox prove that the birth year is truthful?"}]]}],["$","p",null,{"children":"Not yet. The research baseline proves knowledge of a qualifying value, not provenance from a trusted issuer. Production identity assurance requires a signature or commitment from an authorized credential issuer, plus revocation checks."}]]}],["$","details","What personal data is stored?",{"open":false,"children":["$L2","$L3"]}],"$L4","$L5","$L6","$L7","$L8"]}]]}],"$L9","$La"]}],null,"$Lb"]}],"isPartial":"$@c","staleTime":"$d","varyParams":null},{"rsc":"$Le","isPartial":"$@f","staleTime":"$d","varyParams":null},{"rsc":"$L10","isPartial":"$@11","staleTime":"$d","varyParams":"$12"},{"rsc":"$L13","isPartial":"$@14","staleTime":"$d","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@15","rootVaryParams":null,"needsRuntimeRequest":"$@16"}
