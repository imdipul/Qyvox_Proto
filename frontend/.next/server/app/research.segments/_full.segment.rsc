a:["$","section",null,{"className":"findings-grid section-shell","children":[["$","article",null,{"children":[["$","p",null,{"className":"section-label","children":"03 / EDGE COMPUTE"}],["$","h2",null,{"children":"Small artifacts change the browser economics."}],["$","p",null,{"children":"The current WASM and proving key total less than 80 KB, so download size is not the dominant constraint for this baseline. The more important next test is peak memory and worker behavior across Safari and low-end Chromium devices."}],["$","ul",null,{"children":[["$","li",null,{"children":"Run 30 cold and warm proofs per device tier."}],["$","li",null,{"children":"Record p50, p95, peak memory, thermal throttling, and failure rate."}],["$","li",null,{"children":"Move proving to a Web Worker before increasing circuit complexity."}]]}]]}],["$","article",null,{"children":[["$","p",null,{"className":"section-label","children":"04 / VERIFIER OPTIMIZATION"}],["$","h2",null,{"children":"Eliminate process startup, not safety checks."}],["$","p",null,{"children":"Warm Groth16 verification is roughly 29× faster than the current subprocess median in this reference run. A persistent bounded worker pool or native verifier can recover that gap while retaining payload limits, timeouts, concurrency caps, and off-curve handling."}],["$","div",null,{"className":"optimization-bars","aria-label":"Relative verifier latency","children":[["$","span",null,{"children":[["$","i",null,{"style":{"width":"100%"}}],"Current subprocess · 374 ms"]}],["$","span",null,{"children":[["$","i",null,{"style":{"width":"3.5%"}}],"Warm crypto core · 13 ms"]}]]}]]}],["$","article",null,{"children":[["$","p",null,{"className":"section-label","children":"05 / DATA MINIMIZATION"}],["$","h2",null,{"children":"Zero retained DOB changes the compliance surface."}],["$","p",null,{"children":"Qyvox avoids storing demographic input by design. This can reduce breach impact, subject-access scope, retention complexity, and secondary-use risk—but exact legal consequences remain deployment- and jurisdiction-specific."}],["$","div",null,{"className":"impact-record","children":[["$","span",null,{"children":"Birth year"}],["$","strong",null,{"children":"NOT COLLECTED"}],["$","span",null,{"children":"Document imagery"}],["$","strong",null,{"children":"NOT COLLECTED"}],["$","span",null,{"children":"Verification receipt"}],["$","strong",null,{"children":"RETAINED"}]]}]]}]]}]
