e:["$","dd",null,{"children":"≥ 18"}]
f:["$","pre",null,{"className":"docs-code","children":["$","code",null,{"children":"template AgeCheck() {\n  signal input birthYear;\n  signal input currentYear;\n  signal output isEligible;\n\n  component ageThreshold = GreaterEqThan(16);\n  ageThreshold.in[0] <== currentYear - birthYear;\n  ageThreshold.in[1] <== 18;\n  isEligible <== ageThreshold.out;\n}"}]}]
10:["$","p",null,{"className":"docs-note","children":[["$","strong",null,{"children":"Audit note:"}]," the public signal order emitted by SnarkJS is ",["$","code",null,{"children":"[isEligible, currentYear]"}],". Both the client and server reject any other shape or value."]}]
11:["$","section",null,{"id":"client-sdk","children":[["$","p",null,{"className":"section-label","children":"04 / CLIENT INTEGRATION"}],["$","h2",null,{"children":"A deliberately small prover interface."}],["$","p",null,{"children":["The current repository exposes an internal typed module. Publishing it as ",["$","code",null,{"children":"@qyvox/prover"}]," is a release milestone, not a package that is claimed to exist today."]}],["$","pre",null,{"className":"docs-code","children":["$","code",null,{"children":"const { proof, publicSignals } = await generateAgeProof({\n  birthYear: privateYear,\n  currentYear: new Date().getUTCFullYear(),\n});\n\nprivateYear = 0; // clear before authentication or transport\n\nawait fetch(\"/api/v1/verify\", {\n  method: \"POST\",\n  headers: { Authorization: \"Bearer <access-token>\" },\n  body: JSON.stringify({ proof, publicSignals }),\n});"}]}]]}]
12:["$","section",null,{"id":"rest-api","children":[["$","p",null,{"className":"section-label","children":"05 / REST API REFERENCE"}],["$","h2",null,{"children":"POST /api/v1/verify"}],["$","div",null,{"className":"endpoint-line","children":[["$","span",null,{"children":"POST"}],["$","code",null,{"children":"/api/v1/verify"}],["$","strong",null,{"children":"Bearer session required"}]]}],["$","pre",null,{"className":"docs-code","children":["$","code",null,{"children":"{\n  \"proof\": {\n    \"pi_a\": [\"…\", \"…\", \"1\"],\n    \"pi_b\": [[\"…\", \"…\"], [\"…\", \"…\"], [\"1\", \"0\"]],\n    \"pi_c\": [\"…\", \"…\", \"1\"],\n    \"protocol\": \"groth16\",\n    \"curve\": \"bn128\"\n  },\n  \"publicSignals\": [\"1\", \"2026\"]\n}"}]}],["$","p",null,{"className":"docs-note","children":[["$","strong",null,{"children":"Successful response:"}]," the API returns a privacy-safe execution receipt with measured policy, replay, Groth16, and database timings. These measurements are produced during the exact request; no private witness or bearer token is echoed."]}],["$","div",null,{"className":"error-table","children":[["$","div",null,{"children":[["$","strong",null,{"children":"200"}],["$","span",null,{"children":"Proof valid and receipt recorded."}]]}],["$","div",null,{"children":[["$","strong",null,{"children":"401"}],["$","span",null,{"children":"Missing, expired, or invalid Supabase bearer session."}]]}],["$","div",null,{"children":[["$","strong",null,{"children":"403"}],["$","span",null,{"children":"False proof, ineligible output, or stale public year."}]]}],["$","div",null,{"children":[["$","strong",null,{"children":"409"}],["$","span",null,{"children":"Account or exact proof has already been consumed."}]]}],["$","div",null,{"children":[["$","strong",null,{"children":"413 / 422"}],["$","span",null,{"children":"Oversized or structurally invalid proof request."}]]}],["$","div",null,{"children":[["$","strong",null,{"children":"502 / 503"}],["$","span",null,{"children":"Persistence or verifier dependency unavailable."}]]}]]}]]}]
