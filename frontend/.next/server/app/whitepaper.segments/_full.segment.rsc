c:["$","section",null,{"id":"primitives","children":[["$","p",null,{"className":"section-label","children":"03 / PRIMITIVES & CIRCUIT DESIGN"}],["$","h2",null,{"children":"Business policy compiled into field constraints."}],["$","p",null,{"children":"Qyvox uses Groth16 over the BN254 curve because it produces a succinct, non-interactive proof with a small verification workload. Circom compiles the policy into a Rank-1 Constraint System where each constraint is represented as a relation of linear combinations:"}],["$","div",null,{"className":"equation","aria-label":"R1CS equation","children":[["$","span",null,{"children":"⟨A, w⟩"}],["$","i",null,{"children":"×"}],["$","span",null,{"children":"⟨B, w⟩"}],["$","i",null,{"children":"="}],["$","span",null,{"children":"⟨C, w⟩"}]]}],["$","div",null,{"className":"signal-topology","children":[["$","article",null,{"children":[["$","span",null,{"children":"PRIVATE WITNESS"}],["$","strong",null,{"children":"birthYear"}],["$","p",null,{"children":"Exists inside the local witness calculation and is omitted from the request."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"PUBLIC INPUT"}],["$","strong",null,{"children":"currentYear"}],["$","p",null,{"children":"Binds the proof to the verifier's current policy epoch."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"PUBLIC OUTPUT"}],["$","strong",null,{"children":"isEligible = 1"}],["$","p",null,{"children":"Communicates only satisfaction of the threshold statement."}]]}]]}],["$","pre",null,{"className":"paper-code","children":["$","code",null,{"children":"component ageThreshold = GreaterEqThan(16);\nageThreshold.in[0] <== currentYear - birthYear;\nageThreshold.in[1] <== 18;\nisEligible <== ageThreshold.out;\n\ncomponent main { public [currentYear] } = AgeCheck();"}]}],["$","p",null,{"children":"The compiled circuit currently contains 74 constraints, 72 wires, one private input, one public input, and one public output. The API additionally requires the output to be exactly one and the public year to match server UTC time."}]]}]
d:["$","section",null,{"id":"ceremony","children":[["$","p",null,{"className":"section-label","children":"04 / TRUST MODEL & CEREMONY"}],["$","h2",null,{"children":"A trusted setup must be publicly auditable."}],["$","p",null,{"children":"Groth16 requires a circuit-specific structured reference string. Security depends on at least one honest participant destroying their secret contribution. Qyvox's included setup script performs a reproducible single-machine development ceremony and must not be represented as production-ready ceremony evidence."}],["$","ol",null,{"className":"ceremony-steps","children":[["$","li",null,{"children":[["$","span",null,{"children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Universal phase"}],["$","p",null,{"children":"Select a publicly verified Powers of Tau transcript sized above the circuit constraint bound."}]]}]]}],["$","li",null,{"children":[["$","span",null,{"children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Circuit phase"}],["$","p",null,{"children":"Run independent contributions against the exact published R1CS and record transcript hashes."}]]}]]}],["$","li",null,{"children":[["$","span",null,{"children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Public beacon"}],["$","p",null,{"children":"Apply a delayed, publicly sourced random beacon and publish verification output."}]]}]]}],["$","li",null,{"children":[["$","span",null,{"children":"04"}],["$","div",null,{"children":[["$","strong",null,{"children":"Artifact binding"}],["$","p",null,{"children":"Publish R1CS, WASM, zkey, verification key, source commit, and reproducible checksums together."}]]}]]}]]}]]}]
e:["$","section",null,{"id":"threat-model","children":[["$","p",null,{"className":"section-label","children":"05 / THREAT MODEL"}],["$","h2",null,{"children":"Controls, residual risk, and roadmap boundaries."}],["$","div",null,{"className":"threat-table","role":"table","aria-label":"Qyvox threat model","children":[["$","div",null,{"className":"threat-row threat-head","role":"row","children":[["$","span",null,{"children":"Vector"}],["$","span",null,{"children":"Current control"}],["$","span",null,{"children":"Residual / next control"}]]}],[["$","div","Constraint under-determination",{"className":"threat-row","role":"row","children":[["$","span",null,{"children":[["$","strong",null,{"children":"Constraint under-determination"}],["$","small",null,{"children":"A witness satisfies an unintended statement because a signal is insufficiently constrained."}]]}],["$","span",null,{"children":"Double-arrow assignments, circomlib comparator constraints, negative witness tests."}],["$","span",null,{"children":"Formal circuit audit required before production."}]]}],["$","div","Exact proof replay",{"className":"threat-row","role":"row","children":[["$","span",null,{"children":[["$","strong",null,{"children":"Exact proof replay"}],["$","small",null,{"children":"A valid proof payload is submitted more than once."}]]}],["$","span",null,{"children":"SHA-256 proof fingerprint with a unique database constraint."}],["$","span",null,{"children":"Bounded challenge signal is planned for stronger freshness."}]]}],["$","div","Front-running",{"className":"threat-row","role":"row","children":[["$","span",null,{"children":[["$","strong",null,{"children":"Front-running"}],["$","small",null,{"children":"A captured proof is submitted by another authenticated session."}]]}],["$","span",null,{"children":"Proof receipt is associated with the authenticated submitter."}],["$","span",null,{"children":"Current proof is not cryptographically bound to that session."}]]}],["$","div","Stale policy year",{"className":"threat-row","role":"row","children":[["$","span",null,{"children":[["$","strong",null,{"children":"Stale policy year"}],["$","small",null,{"children":"A proof generated for a previous policy epoch is reused."}]]}],["$","span",null,{"children":"FastAPI requires public currentYear to equal the server UTC year."}],["$","span",null,{"children":"Exact-date policy needs a full calendar circuit."}]]}],["$","div","Toxic-waste compromise",{"className":"threat-row","role":"row","children":[["$","span",null,{"children":[["$","strong",null,{"children":"Toxic-waste compromise"}],["$","small",null,{"children":"Setup secrets are retained and used to forge proofs."}]]}],["$","span",null,{"children":"Development artifacts are explicitly non-production."}],["$","span",null,{"children":"Production requires independently verified MPC contributions."}]]}],["$","div","False source data",{"className":"threat-row","role":"row","children":[["$","span",null,{"children":[["$","strong",null,{"children":"False source data"}],["$","small",null,{"children":"A user proves a qualifying year that is not theirs."}]]}],["$","span",null,{"children":"Out of scope for the baseline knowledge proof."}],["$","span",null,{"children":"Issuer-signed credential commitment is required for real identity assurance."}]]}]]]}]]}]
f:["$","section",null,{"id":"limitations","children":[["$","p",null,{"className":"section-label","children":"06 / SECURITY BOUNDS"}],["$","h2",null,{"children":"What Qyvox does—and does not—prove."}],["$","ul",null,{"className":"bounds-list","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Zero knowledge is computational."}],["$","span",null,{"children":"The proof is designed to reveal no witness information beyond the public statement under the proving system's assumptions; “mathematically impossible to recover” would be an overclaim."}]]}],["$","li",null,{"children":[["$","strong",null,{"children":"Calendar-year arithmetic is coarse."}],["$","span",null,{"children":"Everyone born in the same year is treated alike. Exact day-level eligibility requires additional public date signals and range constraints."}]]}],["$","li",null,{"children":[["$","strong",null,{"children":"Source authenticity is absent."}],["$","span",null,{"children":"A production identity engine must prove possession of an issuer-signed credential commitment and support revocation."}]]}],["$","li",null,{"children":[["$","strong",null,{"children":"Freshness is incomplete."}],["$","span",null,{"children":"Exact replay is blocked today, but cryptographic session/challenge binding is a required next circuit revision."}]]}],["$","li",null,{"children":[["$","strong",null,{"children":"Compliance is contextual."}],["$","span",null,{"children":"Data minimization can reduce exposure; it does not automatically make every deployment compliant with every jurisdiction."}]]}]]}]]}]
