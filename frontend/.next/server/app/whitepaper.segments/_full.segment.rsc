7:["$","main",null,{"className":"inner-page","children":[["$","section",null,{"className":"page-hero","children":[["$","div",null,{"className":"page-hero-copy","children":[["$","p",null,{"className":"eyebrow","children":[["$","span",null,{"children":"WP"}]," ","Technical whitepaper / revision 0.1"]}],["$","h1",null,{"children":["A verifiable claim",["$","br",null,{}],["$","span",null,{"children":"without data custody."}]]}],["$","p",null,{"children":"The mathematical statement, trust assumptions, ceremony requirements, and unresolved security boundaries behind the Qyvox research prototype."}]]}],["$","dl",null,{"className":"page-meta","children":[["$","div","Groth16 / BN254",{"children":[["$","dt",null,{"children":"01"}],["$","dd",null,{"children":"Groth16 / BN254"}]]}],["$","div","Circom 2 / 74 constraints",{"children":[["$","dt",null,{"children":"02"}],["$","dd",null,{"children":"Circom 2 / 74 constraints"}]]}],["$","div","Research prototype",{"children":[["$","dt",null,{"children":"03"}],["$","dd",null,{"children":"Research prototype"}]]}],["$","div","Updated 25 Aug 2026",{"children":[["$","dt",null,{"children":"04"}],["$","dd",null,{"children":"Updated 25 Aug 2026"}]]}]]}]]}],["$","div",null,{"className":"paper-layout section-shell","children":[["$","aside",null,{"className":"paper-toc","aria-label":"Whitepaper contents","children":[["$","p",null,{"children":"CONTENTS"}],["$","a",null,{"href":"#abstract","children":"01 · Abstract"}],["$","a",null,{"href":"#threat-landscape","children":"02 · Threat landscape"}],["$","a",null,{"href":"#primitives","children":"03 · Primitives & circuit"}],["$","a",null,{"href":"#ceremony","children":"04 · Trust ceremony"}],["$","a",null,{"href":"#threat-model","children":"05 · Threat model"}],["$","a",null,{"href":"#limitations","children":"06 · Security bounds"}],["$","a",null,{"href":"#references","children":"07 · References"}]]}],["$","article",null,{"className":"paper-content","children":[["$","section",null,{"id":"abstract","children":[["$","p",null,{"className":"section-label","children":"01 / ABSTRACT"}],["$","h2",null,{"children":"Data minimization as a cryptographic property."}],["$","p",null,{"className":"paper-lede","children":"Qyvox is a client-proving, server-verifying age-assurance baseline. A private birth year and a public policy year enter an arithmetic circuit. The output states only whether the difference meets an 18-year threshold."}],["$","p",null,{"children":"The browser constructs the witness and Groth16 proof locally. The server receives the proof and public signals, authenticates the requesting session, rejects stale policy epochs, verifies the proof against a fixed key, and stores a privacy-minimal receipt. The system avoids taking custody of the birth year rather than merely encrypting it after collection."}],["$","div",null,{"className":"paper-callout","children":[["$","strong",null,{"children":"Claim boundary"}],["$","p",null,{"children":["The baseline proves knowledge of ",["$","em",null,{"children":"a"}]," qualifying birth year. It does not yet prove that the witness came from a trusted government or institutional issuer."]}]]}]]}],["$","section",null,{"id":"threat-landscape","children":[["$","p",null,{"className":"section-label","children":"02 / THREAT LANDSCAPE"}],["$","h2",null,{"children":"Centralized assurance externalizes permanent risk."}],["$","p",null,{"children":"Conventional identity gates concentrate names, dates of birth, document imagery, and addresses into reusable records. Encryption reduces exposure at rest but does not eliminate collection, operational access, retention, deletion, breach notification, or insider-risk obligations."}],["$","div",null,{"className":"paper-statements","children":[["$","article",null,{"children":[["$","span",null,{"children":"COLLECTION"}],["$","h3",null,{"children":"Every copied field becomes an asset to defend."}],["$","p",null,{"children":"Security responsibility persists long after the eligibility decision is made."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"CORRELATION"}],["$","h3",null,{"children":"Stable identity records link activity across systems."}],["$","p",null,{"children":"Data minimization limits the material available for secondary use and compromise."}]]}]]}]]}],"$Lc","$Ld","$Le","$Lf","$L10"]}]]}]]}]
