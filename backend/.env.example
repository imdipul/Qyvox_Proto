# Server-only Supabase credentials. Never expose the service-role key to Next.js.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated exact origins. Wildcards are intentionally unsupported when
# credentials/Authorization headers are enabled.
FRONTEND_ORIGINS=http://localhost:3000

# Optional operational settings.
NODE_BINARY=node
VERIFICATION_TIMEOUT_SECONDS=20
VERIFIER_CONCURRENCY=2
MAX_REQUEST_BYTES=32768
